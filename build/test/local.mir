--- |
  ; ModuleID = '/home/whe302/compilers/nvptx_analyzer/test/local.ll'
  source_filename = "/home/whe302/compilers/nvptx_analyzer/test/local.ll"
  target datalayout = "e-p6:32:32-i64:64-i128:128-i256:256-v16:16-v32:32-n16:32:64"
  target triple = "nvptx64-nvidia-cuda"
  
  define ptx_kernel void @local_kernel(ptr addrspace(1) %a, ptr addrspace(1) %b, ptr addrspace(1) %out) #0 {
  entry:
    %arr = alloca [4 x float], align 4
    %0 = addrspacecast ptr %arr to ptr addrspace(5)
    %va = load float, ptr addrspace(1) %a, align 4
    %vb = load float, ptr addrspace(1) %b, align 4
    %sum = fadd float %va, %vb
    %tid = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
    %idx = and i32 %tid, 3
    %idxprom1 = sext i32 %idx to i64
    %slot = getelementptr [4 x float], ptr addrspace(5) %0, i64 0, i64 %idxprom1
    store volatile float %sum, ptr addrspace(5) %slot, align 4
    %r = load volatile float, ptr addrspace(5) %slot, align 4
    store float %r, ptr addrspace(1) %out, align 4
    ret void
  }
  
  ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
  declare noundef range(i32 0, 1024) i32 @llvm.nvvm.read.ptx.sreg.tid.x() #1
  
  attributes #0 = { "target-cpu"="sm_80" }
  attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) "target-cpu"="sm_80" }
  
  !nvvm.annotations = !{}
...
---
name:            local_kernel
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
