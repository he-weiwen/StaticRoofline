    %add = add i32 %mul, %4
    %idxprom = sext i32 %add to i64
    %arrayidx = getelementptr inbounds [4 x i8], ptr addrspace(1) %0, i64 %idxprom
    %7 = load i32, ptr addrspace(1) %arrayidx, align 4, !tbaa !3
    %arrayidx5 = getelementptr inbounds [4 x i8], ptr addrspace(1) %1, i64 %idxprom
    %8 = load i32, ptr addrspace(1) %arrayidx5, align 4, !tbaa !3
    %arrayidx8 = getelementptr inbounds [4 x i8], ptr addrspace(1) %2, i64 %idxprom
    %9 = load i32, ptr addrspace(1) %arrayidx8, align 4, !tbaa !3
    %10 = tail call i32 asm "{fma.rn.f16x2 $0,$1,$2,$3;\0A}", "=r,r,r,r"(i32 %7, i32 %8, i32 %9) #2, !srcloc !7
    %arrayidx10 = getelementptr inbounds [4 x i8], ptr addrspace(1) %3, i64 %idxprom
    store i32 %10, ptr addrspace(1) %arrayidx10, align 4, !tbaa !3
    ret void
  }
  
